# Placeholder-only template; never put real credentials in this tracked file.
# The application reads PROCESS environment variables. It does not load .env.
# Use your process manager/secret manager to inject values; see MIGRATIONS.md.
# python-dotenv is not part of the pinned environment; do not use --env-file.
ENVIRONMENT=production
# This exact placeholder is explicitly rejected. Generate a unique random
# value (at least 32 characters) privately in your secret manager.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
# Intentionally invalid until replaced. SQLite is built into Python; PyMySQL
# is pinned. Supply an absolute SQLite path or a mysql+pymysql connection URL.
DATABASE_URL=REPLACE_WITH_EXPLICIT_DATABASE_URL
# Empty denies cross-origin browser access, not all HTTP access. Production
# origins must be exact HTTPS origins, comma-separated, with no trailing slash.
CORS_ORIGINS=

# Optional recovery delivery: empty host/sender/URL keeps delivery unavailable.
# Configure together before offering password recovery. Use a trusted relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Credentials must be supplied as a pair with TLS. For implicit TLS use
# SMTP_TLS=ssl and SMTP_PORT=465. No TLS only permits development loopback.
# Production RECOVERY_URL must be an HTTPS reset page without query/fragment.
RECOVERY_URL=

# Explicit numeric values: an empty queue limit is NOT a valid default.
SENTINEL_SCAN_WORKERS=2
SENTINEL_SCAN_QUEUE_LIMIT=100
SENTINEL_ALLOWED_DESTINATION_PORTS=80,443
# Keep external-tool isolation opt-in disabled. This flag does not provide a
# sandbox and does not disable every background worker/network-capable feature.
SENTINEL_SCANNER_EGRESS_ISOLATED=0
# Optional external daemon integration remains unconfigured.
SENTINEL_ZAP_API_URL=
SENTINEL_ZAP_API_KEY=
# Deployment-managed settings credential reference/configured indicator.
# This is NOT an SDK ingestion key; no outbound provider use is implied.
SENTINEL_AI_API_KEY=
