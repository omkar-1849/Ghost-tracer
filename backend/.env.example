# =============================================================================
# Sentinel AI — Backend Configuration Template
# =============================================================================
# Placeholder-only template; NEVER commit real credentials to this file.
# The application reads PROCESS environment variables or .env in local dev.
# In production, inject secrets via your secret manager / container environment.
# =============================================================================

# Environment: 'development', 'staging', or 'production'
ENVIRONMENT=production

# JWT signing secret (minimum 32 characters, randomly generated)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Database connection URL (SQLite or MySQL with PyMySQL driver)
DATABASE_URL=sqlite:///./sentinel_dev.db

# Allowed CORS origins (comma-separated, no trailing slashes)
CORS_ORIGINS=https://sentinel.example.com

# -----------------------------------------------------------------------------
# Background Workers & Rate Limiting
# -----------------------------------------------------------------------------
SENTINEL_SCAN_WORKERS=2
SENTINEL_SCAN_QUEUE_LIMIT=100
SENTINEL_ALLOWED_DESTINATION_PORTS=80,443,8080

# Auth rate limiting
AUTH_RATE_EMAIL_LIMIT=10
AUTH_RATE_IP_LIMIT=100
AUTH_RATE_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# AI Analyst & Inference Server (GT-Beta)
# -----------------------------------------------------------------------------
AI_ANALYST_ENABLED=true
AI_ANALYST_URL=http://127.0.0.1:8001/v1/analyze
AI_ANALYST_TIMEOUT=30
SENTINEL_AI_API_KEY=

# -----------------------------------------------------------------------------
# Scanner Engines & External Tool Binaries
# -----------------------------------------------------------------------------
# Operator-confirmed egress isolation flag for external subprocesses
SENTINEL_SCANNER_EGRESS_ISOLATED=0

# Absolute paths to authorized scanner executables on the host
SENTINEL_SCANNER_BIN_NMAP=
SENTINEL_SCANNER_BIN_NUCLEI=
SENTINEL_SCANNER_BIN_SQLMAP=
SENTINEL_SCANNER_BIN_NIKTO=

# Isolated OWASP ZAP daemon integration (optional)
SENTINEL_ZAP_API_URL=
SENTINEL_ZAP_API_KEY=

# Host filtering for scan targets
SENTINEL_ALLOWED_TARGET_HOSTS=localhost,127.0.0.1
SENTINEL_PROTECTED_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Password Recovery SMTP Relay (Optional)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
RECOVERY_URL=
